name = "oboard/morm"

version = "0.4.1"

import {
  "moonbitlang/x@0.5.1",
  "moonbitlang/parser@0.3.17",
  "moonbitlang/async@0.21.0",
}

readme = "README.mbt.md"

repository = "https://github.com/oboard/morm"

license = "Apache-2.0"

keywords = [
  "orm",
  "database",
  "sql",
  "query builder",
  "code generation",
  "moonbit",
]

description = "A lightweight MoonBit ORM with typed queries, code generation, and multi-database engines"

preferred_target = "native"
