import {
  "f4ah6o/duckdb" @driver,
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string",
  "oboard/morm/engine" @morm/engine,
  "oboard/morm/table",
}

import {
  "moonbitlang/async",
  "moonbitlang/core/json",
  "oboard/morm",
  "oboard/morm/time",
} for "test"

supported_targets = "+native"

options(
  link: {
    "native": {
      "cc-link-flags": "-L/opt/homebrew/lib -Wl,-rpath,/opt/homebrew/lib -L/usr/local/lib -Wl,-rpath,/usr/local/lib -lduckdb",
    },
  },
)
